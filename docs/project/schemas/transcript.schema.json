{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-recorder/transcript.schema.json",
  "title": "Interview Recorder transcript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "sessionCode", "language", "engine", "createdAt", "updatedAt", "disclaimer", "segments", "history", "review"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sessionId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sessionCode": { "type": "string", "pattern": "^IR-[0-9]{8}-[0-9]{6}-[0-9A-F]{4}$" },
    "language": { "type": "string", "minLength": 2, "maxLength": 8 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "model", "modelSha256"],
      "properties": {
        "name": { "const": "whisper.cpp" },
        "version": { "type": "string" },
        "model": { "type": "string" },
        "modelSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "createdAt": { "$ref": "#/$defs/time" },
    "updatedAt": { "$ref": "#/$defs/time" },
    "disclaimer": { "const": "This transcript was produced by automated speech recognition and may contain errors. Check it against the audio recording before you rely on it." },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "speaker", "speakerVerified", "source", "text", "originalText", "edited"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "speaker": { "type": "string", "minLength": 1, "maxLength": 40 },
          "speakerVerified": { "type": "boolean" },
          "source": { "enum": ["mic", "meeting", "mixed"] },
          "text": { "type": "string" },
          "originalText": { "type": "string" },
          "edited": { "type": "boolean" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segmentId", "field", "at", "oldLength", "newLength"],
        "properties": {
          "segmentId": { "type": "integer", "minimum": 1 },
          "field": { "enum": ["text", "speaker", "speakerVerified"] },
          "at": { "$ref": "#/$defs/time" },
          "oldLength": { "type": "integer", "minimum": 0 },
          "newLength": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "review": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reviewerInitials", "at"],
      "properties": {
        "reviewerInitials": { "type": "string", "pattern": "^[A-Za-z]{1,8}$" },
        "at": { "$ref": "#/$defs/time" },
        "note": { "type": ["string", "null"], "maxLength": 200 }
      }
    }
  },
  "$defs": {
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
