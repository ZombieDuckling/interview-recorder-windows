{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-recorder/session.schema.json",
  "title": "Interview Recorder session manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "sessionCode", "participantId", "consent", "createdAt", "state", "stateHistory", "app", "recording", "streams", "hashes", "retention", "audit"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sessionId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sessionCode": { "type": "string", "pattern": "^IR-[0-9]{8}-[0-9]{6}-[0-9A-F]{4}$" },
    "participantId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$" },
    "studyCode": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$" },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "confirmedAt"],
      "properties": {
        "confirmed": { "const": true },
        "confirmedAt": { "$ref": "#/$defs/time" }
      }
    },
    "createdAt": { "$ref": "#/$defs/time" },
    "state": { "$ref": "#/$defs/state" },
    "stateHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "at"],
        "properties": { "state": { "$ref": "#/$defs/state" }, "at": { "$ref": "#/$defs/time" } }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["stage", "code", "at"],
      "properties": {
        "stage": { "enum": ["Recording", "Finalizing", "Transcribing", "Exporting", "Recovery"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,40}$" },
        "at": { "$ref": "#/$defs/time" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform", "osVersion", "arch"],
      "properties": {
        "name": { "const": "Interview Recorder" },
        "version": { "type": "string" },
        "platform": { "enum": ["macos", "windows"] },
        "osVersion": { "type": "string" },
        "arch": { "enum": ["arm64", "x86_64", "x64"] }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "stoppedAt", "durationSeconds"],
      "properties": {
        "startedAt": { "$ref": "#/$defs/timeOrNull" },
        "stoppedAt": { "$ref": "#/$defs/timeOrNull" },
        "durationSeconds": { "type": ["number", "null"], "minimum": 0 },
        "recovered": { "type": "boolean" }
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source", "deviceType", "sampleRate", "channels", "bitsPerSample", "chunkFrames", "firstFrameOffset", "chunks"],
        "properties": {
          "kind": { "enum": ["meeting", "mic"] },
          "source": { "enum": ["screencapturekit", "coreaudio-tap", "avaudioengine", "wasapi-loopback", "wasapi-process-loopback", "wasapi-capture"] },
          "deviceType": { "enum": ["builtin", "usb", "bluetooth", "virtual", "system", "unknown"] },
          "sampleRate": { "const": 48000 },
          "channels": { "const": 1 },
          "bitsPerSample": { "const": 16 },
          "chunkFrames": { "const": 480000 },
          "firstFrameOffset": { "type": "integer", "minimum": 0 },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "frames", "sha256"],
              "properties": {
                "file": { "type": "string", "pattern": "^capture/(meeting|mic)/[0-9]{6}\\.wav$" },
                "frames": { "type": "integer", "minimum": 0 },
                "sha256": { "$ref": "#/$defs/sha256" },
                "recovered": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "transcription": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["engine", "engineVersion", "model", "modelSha256", "language", "threads"],
      "properties": {
        "engine": { "const": "whisper.cpp" },
        "engineVersion": { "type": "string" },
        "model": { "type": "string" },
        "modelSha256": { "$ref": "#/$defs/sha256" },
        "language": { "type": "string" },
        "threads": { "type": "integer", "minimum": 1 },
        "startedAt": { "$ref": "#/$defs/timeOrNull" },
        "completedAt": { "$ref": "#/$defs/timeOrNull" },
        "peakMemoryMB": { "type": ["number", "null"] }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio": { "$ref": "#/$defs/output" },
        "transcriptJson": { "$ref": "#/$defs/output" },
        "docx": { "$ref": "#/$defs/output" }
      }
    },
    "hashes": {
      "type": "object",
      "description": "session-relative path -> SHA-256 of every closed chunk and output file",
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "integrity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["hmac", "keyStore"],
      "properties": {
        "hmac": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "keyStore": { "enum": ["macos-keychain", "windows-dpapi"] }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deleteAfterDays", "dueAt"],
      "properties": {
        "deleteAfterDays": { "type": ["integer", "null"], "minimum": 1, "maximum": 3650 },
        "dueAt": { "$ref": "#/$defs/timeOrNull" }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "at"],
        "properties": {
          "event": { "enum": ["created", "recording_started", "recording_stopped", "transcribed", "edited", "exported", "reviewed", "opened", "deleted_files"] },
          "at": { "$ref": "#/$defs/time" }
        }
      }
    }
  },
  "$defs": {
    "state": { "enum": ["Recording", "Finalizing", "ReadyToTranscribe", "Transcribing", "Exported", "Failed", "Recovered"] },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "timeOrNull": { "anyOf": [ { "$ref": "#/$defs/time" }, { "type": "null" } ] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["file", "sha256", "writtenAt"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,128}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "writtenAt": { "$ref": "#/$defs/time" },
        "durationSeconds": { "type": ["number", "null"] }
      }
    }
  }
}
