<Window x:Class="Recorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Recorder.App.Views"
        xmlns:nav="clr-namespace:Recorder.App.Navigation"
        Title="Interview Recorder"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        Background="{DynamicResource SurfaceBrush}"
        Closing="MainWindow_OnClosing">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit"
                  InputGestureText="Alt+F4"
                  Click="ExitMenuItem_OnClick"/>
      </MenuItem>
      <MenuItem Header="_Session">
        <MenuItem Header="_New interview"
                  InputGestureText="Ctrl+N"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="{x:Static nav:AppPage.NewInterview}"/>
        <MenuItem Header="_Start recording"
                  InputGestureText="Ctrl+R"
                  Command="{Binding StartInterviewCommand}"/>
        <MenuItem Header="_Session library"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="{x:Static nav:AppPage.SessionLibrary}"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Diagnostics and help"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="{x:Static nav:AppPage.DiagnosticsHelp}"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceAltBrush}"
            Padding="12,8">
      <TextBlock Style="{StaticResource StatusTextStyle}"
                 AutomationProperties.AutomationId="MainStatusLine"
                 AutomationProperties.Name="Application status"
                 Text="{Binding WindowStatus}"/>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0"
              Background="{DynamicResource SurfaceAltBrush}"
              Padding="8">
        <StackPanel>
          <TextBlock Margin="8,8,8,16"
                     Text="Interview Recorder"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <ListBox AutomationProperties.AutomationId="MainNavigation"
                   AutomationProperties.Name="Main navigation"
                   ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNavItem}"
                   BorderThickness="0"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="4" Text="{Binding Title}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1">
        <views:WelcomeView DataContext="{Binding Welcome}"
                           Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Welcome}"/>
        <views:DevicesView DataContext="{Binding Devices}"
                           Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Devices}"/>
        <views:NewInterviewView DataContext="{Binding NewInterview}"
                                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=NewInterview}"/>
        <views:SessionLibraryView DataContext="{Binding SessionLibrary}"
                                  Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=SessionLibrary}"/>
        <views:PrivacySettingsView DataContext="{Binding Privacy}"
                                   Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=PrivacySettings}"/>
        <views:DiagnosticsHelpView DataContext="{Binding Diagnostics}"
                                   Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=DiagnosticsHelp}"/>
        <views:RecordingConsoleView DataContext="{Binding RecordingConsole}"
                                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=RecordingConsole}"/>
        <views:ProcessingProgressView DataContext="{Binding Processing}"
                                      Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=ProcessingProgress}"/>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
