<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>InterviewRecorder</AssemblyName>
    <RootNamespace>Recorder.App</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Recorder.Core\Recorder.Core.csproj" />
    <ProjectReference Include="..\Recorder.Audio.Windows\Recorder.Audio.Windows.csproj" />
    <ProjectReference Include="..\Recorder.Media\Recorder.Media.csproj" />
    <ProjectReference Include="..\Recorder.Transcription\Recorder.Transcription.csproj" />
    <ProjectReference Include="..\Recorder.Export\Recorder.Export.csproj" />
    <ProjectReference Include="..\Recorder.Security\Recorder.Security.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
