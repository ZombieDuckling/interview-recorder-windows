<UserControl x:Class="Recorder.App.Controls.LevelMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Recorder.App.Converters">
  <UserControl.Resources>
    <conv:DbfsToMeterWidthConverter x:Key="DbfsToWidth"/>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{Binding Label}" FontSize="14"/>
    <ProgressBar Minimum="0"
                 Maximum="100"
                 Height="16"
                 Margin="0,4,0,0"
                 Foreground="{DynamicResource AccentBrush}"
                 Value="{Binding PeakDbfs, Converter={StaticResource DbfsToWidth}}"/>
  </StackPanel>
</UserControl>
