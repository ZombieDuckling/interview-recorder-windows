<UserControl x:Class="Recorder.App.Views.DiagnosticsHelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
      <TextBlock Text="Diagnostics and help" Style="{StaticResource TitleTextStyle}"/>
      <TextBlock Margin="0,12,0,4" Text="{Binding AppVersion, StringFormat=App version {0}}"/>
      <TextBlock Text="{Binding OsVersion, StringFormat=OS {0}}"/>
      <TextBlock Margin="0,0,0,8" Text="{Binding Arch, StringFormat=Architecture {0}}"/>
      <TextBlock Text="{Binding ModelText}" TextWrapping="Wrap"/>
      <Button Margin="0,12,0,16"
              HorizontalAlignment="Left"
              AutomationProperties.AutomationId="DiagnosticsOpenLogs"
              AutomationProperties.Name="Open log folder"
              Content="Open _log folder"
              Command="{Binding OpenLogFolderCommand}"/>
      <ListBox AutomationProperties.AutomationId="DiagnosticsHelpTopics"
               AutomationProperties.Name="Help topics"
               ItemsSource="{Binding Topics}"
               DisplayMemberPath="Title"
               SelectedItem="{Binding SelectedTopic}"/>
    </StackPanel>
    <ScrollViewer Grid.Column="1" Margin="24,0,0,0">
      <StackPanel>
        <TextBlock Text="{Binding SelectedTopic.Title}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Margin="0,12,0,0" Text="{Binding SelectedTopic.Body}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
