<UserControl x:Class="Recorder.App.Views.RecordingConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Recorder.App.Controls">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Grid.Row="0">
      <Ellipse Width="20" Height="20" Fill="{DynamicResource RecordingBrush}" VerticalAlignment="Center"/>
      <TextBlock Margin="12,0,0,0"
                 VerticalAlignment="Center"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource RecordingBrush}"
                 Text="Recording"/>
    </StackPanel>
    <TextBlock Grid.Row="1"
               Margin="0,16,0,24"
               HorizontalAlignment="Center"
               FontSize="56"
               FontWeight="SemiBold"
               FontFamily="Segoe UI"
               AutomationProperties.AutomationId="RecordingTimer"
               AutomationProperties.Name="Recording elapsed time"
               Text="{Binding Elapsed, Converter={StaticResource ClockConverter}}"/>
    <StackPanel Grid.Row="2" MaxWidth="480" HorizontalAlignment="Center">
      <controls:LevelMeterControl DataContext="{Binding MicMeter}" Margin="0,0,0,16"/>
      <controls:LevelMeterControl DataContext="{Binding MeetingMeter}"/>
    </StackPanel>
    <StackPanel Grid.Row="3">
      <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding FreeDiskText}"/>
      <TextBlock Margin="0,8,0,16" Style="{StaticResource StatusTextStyle}" Text="{Binding StatusMessage}"/>
      <Button HorizontalAlignment="Left"
              Style="{StaticResource DangerButtonStyle}"
              AutomationProperties.AutomationId="RecordingStop"
              AutomationProperties.Name="Stop recording"
              Content="_Stop recording"
              Command="{Binding RequestStopCommand}"/>
    </StackPanel>
  </Grid>
</UserControl>
