<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!-- WiX Burn bootstrapper (.exe). The chain holds only the per-user MSI, so Burn never asks for elevation. -->
  <Bundle Name="Interview Recorder" Manufacturer="Interview Recorder" Version="$(var.ProductVersion)"
          IconSourceFile="..\assets\app.ico" UpgradeCode="{5E7C1FD0-42B8-4226-ADAD-D9D01D5982C5}" DisableModify="yes">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="rtfLicense" LicenseFile="..\assets\license.rtf" LogoFile="..\assets\logo.png"
                                              ShowVersion="yes" SuppressOptionsUI="yes" SuppressRepair="yes"
                                              LaunchTarget="[LocalAppDataFolder]Programs\Interview Recorder\InterviewRecorder.exe" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(var.MsiPath)" Visible="no" />
    </Chain>
  </Bundle>
</Wix>
