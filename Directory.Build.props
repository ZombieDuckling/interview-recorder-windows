<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <Company>Interview Recorder</Company>
    <Product>Interview Recorder</Product>
    <Version>1.0.0</Version>
    <!-- No telemetry, no network: see ADR-0002 and build/guard.ps1 -->
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests')) Or '$(MSBuildProjectName)' == 'Recorder.E2E'">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861</NoWarn>
  </PropertyGroup>
</Project>
